# Pulse - Auto Check-in System Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase Project Configuration
# Get these from your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for sensitive credentials (32-byte hex)
# Generate with: openssl rand -hex 32
PULSE_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
